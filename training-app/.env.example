# Copia:  copy .env.example .env
# Poi compila SOLO le righe sotto (mai lasciare parentesi quadre o placeholder).

# Supabase → Project Settings → Database → Connection string → URI → Direct (5432)
# Incolla la stringa COMPLETA generata da Supabase (Ctrl+C dalla dashboard).
# Se la password contiene @ # : / ? % & = codifica i caratteri (es. @ → %40).
# Esempio formato (NON usare questo — usa la tua stringa dalla dashboard):
# postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Stringa casuale ≥ 32 caratteri (genera: openssl rand -hex 32)
PAYLOAD_SECRET=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe (opzionale — module 11)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard: https://supabase.com/dashboard/project/ieeriszlalrsbfsnarih
